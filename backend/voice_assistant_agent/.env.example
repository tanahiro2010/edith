# --- Server ---
PORT=8010

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/edith_agent

# --- LLM (deniai.app — OpenAI compatible) ---
LLM_BASE_URL=https://api.deniai.app/v1
LLM_API_KEY=deni_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=openai/gpt-5.2

# --- Face API (既存の顔認識サービス) ---
FACE_API_BASE_URL=http://localhost:8000

# --- STT (ローカル文字起こしサービス: backend/stt_service) ---
STT_BASE_URL=http://localhost:8020

# --- Default user (MVP: 認証は未実装。全リクエストをこのユーザーに紐付ける) ---
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
